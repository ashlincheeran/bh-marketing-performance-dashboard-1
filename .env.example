# ─────────────────────────────────────────────────────────────
# betterhomes Marketing Hub — environment variables
# Copy the names into Vercel → Project → Settings → Environment Variables.
# Everything degrades gracefully: a missing var only disables its section.
# ─────────────────────────────────────────────────────────────

# ── Supabase (dashboard's own DB: PR, social, SEO config) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude (the news bot's check and the PR & Media insights) ──
# A workspace key from platform.claude.com, with a spend limit on the workspace.
# The model is chosen in Settings → News bot (Haiku by default).
ANTHROPIC_API_KEY=

# ── Gemini (social sentiment, and the Socials and Website insight buttons) ──
GEMINI_API_KEY=
# GOOGLE_API_KEY=                      # accepted as a fallback for GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.5-flash-lite   # optional override

# ── Apify (People Sentiment + Social Performance scraping) ──
APIFY_TOKEN=
# SOCIAL_MAX_MS=285000      # wall-clock budget per scrape run (must stay under maxDuration)
# SOCIAL_SCORE_MAX=60       # max posts sent for AI sentiment scoring per run

# ── Endpoint auth (protects the write/ingest routes) ──
# Without these the routes reject every request with 401: set them or the
# news bot (/api/news, which also hands each step to the next with this
# secret), the other daily syncs and /api/seed won't work.
CRON_SECRET=
SEED_SECRET=

# ── PIN gate (the app PIN and the Settings PIN) ──
# Set SESSION_SECRET to a long random value (for example: openssl rand -hex 32),
# the same on production and preview. It signs both PIN cookies, and the weekly
# email's capture signs one with it to open the production dashboard. Until it
# is set the cookies are signed with CRON_SECRET. Changing it, or a PIN, asks
# everyone for their PINs again.
SESSION_SECRET=
# DASHBOARD_PIN=    # the app PIN. Set it: without it the PIN is the one written in lib/gate.ts
# SETTINGS_PIN=     # the Settings PIN. Set it for the same reason

# ── PR & Media news bot ──
# Keywords, rivals and spokespeople are edited on the PR & Media tab, and the
# model, Apify backup and search window in Settings, not here.
# NEWS_EDITION=hl=en-AE&gl=AE&ceid=AE:en   # Google News edition (UAE English by default)
# VERCEL_AUTOMATION_BYPASS_SECRET=          # set by Vercel when "Protection Bypass for
#                                           # Automation" is on; lets the bot's chained
#                                           # steps reach a preview behind Vercel's login

# ── PostHog (Website + SEO analytics) ──
POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.posthog.com  # optional
# POSTHOG_PROJECT_ID=198002            # optional
# POSTHOG_TIMEOUT_MS=15000             # optional per-query cap

# ── SEO tab · Google Search Console via Supermetrics ──
# (pick ONE of the two GSC backends below)
# A) Supermetrics Data Fetching API — no Google Cloud setup:
SUPERMETRICS_API_KEY=
# SUPERMETRICS_DS_USER=zahra.firouzi@bhomes.com   # who authorized GSC (default)
# SUPERMETRICS_API_URL=                            # override endpoint if needed
#
# Digital Performance tab. Supermetrics authorises each source to the person who
# connected it, not to the API key, so every ad platform needs the login that
# authorised THAT source — the GSC one above is not valid for any of them and
# produces 403 QUERY_AUTH_UNAVAILABLE. Confirm the owners under
# hub.supermetrics.com/token-management.
# SUPERMETRICS_DS_USER_GOOGLE=      # e.g. alina.osmanli@ / marketing@ / digital@bhomes.com
# SUPERMETRICS_DS_USER_META=        # Ashlin Cheeran — try 122111799831053725
# SUPERMETRICS_DS_USER_LINKEDIN=    # Qaswa Kamran
# B) OR a Google service account talking to GSC directly:
# GSC_CLIENT_EMAIL=
# GSC_PRIVATE_KEY=
GSC_SITE_URL=sc-domain:bhomes.com

# ── SEO tab · Metabase (organic & AI leads) ──
# Username/password login (the "API connection"):
METABASE_URL=
METABASE_USERNAME=
METABASE_PASSWORD=
# METABASE_API_KEY=      # optional alternative to username/password
# METABASE_DB_ID=14      # the betterhomes database id (default 14)
